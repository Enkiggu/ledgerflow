      "title": "Rate Limit Rejections (429)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(rate_limit_rejections_total[1m]))",
          "legendFormat": "429 Rejections / sec"
        }
      ]
    },
    {
